# Expo public env vars. Copy to `.env` and adjust.
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time,
# so never put a secret here.

# Base URL of the Kitchen API. Ignored while mocks are on.
EXPO_PUBLIC_API_URL=http://localhost:3333

# MSW is on unless this is exactly "false" (see src/lib/api.ts).
# Leave mocks on for simulator work; turn them off to hit a real API and real OAuth.
EXPO_PUBLIC_USE_MOCKS=true

# Google OAuth client ids, one per platform (Google issues a separate id for each).
# These are public by design — they ship inside the app binary.
# `app.config.js` derives the reversed-client-id URL scheme from the iOS value,
# and `src/lib/oauth.ts` derives the matching redirect URI, so the two cannot drift.
# The API must pin the same ids in GOOGLE_CLIENT_ID (repo-root .env, comma separated).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
