# ---- Database ----
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kitchen:kitchen@localhost:5432/kitchen

# ---- Redis (BullMQ) ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO in dev, S3 in prod) ----
# ---- Object storage ----
# Host ports only; containers always reach MinIO on 9000 internally. Override if
# 9000/9001 are already taken locally (and update S3_ENDPOINT to match).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kitchen-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth client IDs. Leave empty for local development; MUST be set in production
# so the `aud` claim of incoming Apple/Google ID tokens is pinned.
#
# Both accept a comma-separated list, because each platform gets its own client
# id. Google issues one per platform; Apple uses the iOS bundle id for a native
# sign-in and a Services ID on the web. List every client the API should accept:
#   GOOGLE_CLIENT_ID=<ios>.apps.googleusercontent.com,<web>.apps.googleusercontent.com
#   APPLE_CLIENT_ID=com.kitchenai.app,com.kitchenai.web
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Apple Sign-In revocation — only required when APPLE_REVOKE_MOCK=false
APPLE_REVOKE_MOCK=true
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENC_KEY=

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL_PLANNING=gpt-5
OPENAI_MODEL_VISION=gpt-5
OPENAI_MODEL_CHEAP=gpt-5-mini
# Gemini serves the vision tier only, and only when AI_VISION_VENDOR=gemini.
# GEMINI_API_KEY is required in that case (and enforced when AI_MOCK=false).
GEMINI_API_KEY=
GEMINI_MODEL_VISION=gemini-3-flash
# The switch that routes the vision tier: openai (default) keeps today's
# behaviour; gemini routes vision to Gemini with a one-hop fallback to OpenAI.
AI_VISION_VENDOR=openai
AI_MOCK=true
AI_DAILY_BUDGET_USD=2.00

# ---- External APIs ----
YOUTUBE_API_KEY=
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org

# ---- Apps ----
API_PORT=3333
NEXT_PUBLIC_API_URL=http://localhost:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# Both clients ship an MSW mock layer that is ON unless explicitly disabled, so
# they run with no API. Set both to false to talk to a real API.
NEXT_PUBLIC_API_MOCK=true
EXPO_PUBLIC_USE_MOCKS=true
