# Production environment for the single-VM deployment (docker-compose.prod.yml
# + deploy/docker-compose.caddy.yml). Copy to the repo root as `.env` on the VM
# and fill every value marked REQUIRED. The API refuses to boot on an invalid
# environment (see apps/api/src/config/env.ts), so a missing value fails fast
# with a named error rather than at the first request.
#
#   cp deploy/.env.prod.example .env   # then edit
#
# Generate secrets with:
#   openssl rand -base64 48     # JWT_SECRET
#   openssl rand -base64 32     # APPLE_TOKEN_ENC_KEY (decodes to 32 bytes)

# ---- Runtime ----
# Turns on every fail-closed guard below. Do not run production with anything else.
NODE_ENV=production

# ---- Database (self-hosted on the VM, private network) ----
# The compose file builds DATABASE_URL from these; you normally do not set
# DATABASE_URL yourself. Pick a strong password — the DB is only on the private
# compose network, but treat it as a secret anyway.
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=kitchen

# ---- Redis (self-hosted on the VM, private network) ----
# REDIS_URL is set to redis://redis:6379 by the compose file.

# ---- HTTP edge (Caddy) ----
# REQUIRED. A hostname whose DNS A/AAAA record points at this VM's public IP.
# Caddy provisions a free Let's Encrypt certificate for it automatically.
# A free subdomain from DuckDNS (e.g. mykitchen.duckdns.org) works fine.
API_DOMAIN=api.example.com
# Keep the API off the public interface; only Caddy (80/443) is exposed.
API_BIND_HOST=127.0.0.1
# REQUIRED in production. Origins allowed to call the API with credentials.
# A native mobile app sends no Origin, so this matters only if a browser calls
# the API; set it to your web origin, or a placeholder if there is no web app.
CORS_ORIGINS=https://app.example.com

# ---- Object storage: Cloudflare R2 (free tier, S3-compatible) ----
# Create an R2 bucket + an R2 API token (Object Read & Write) in the Cloudflare
# dashboard. The endpoint is per-account; region is the literal string "auto".
# Presigned PUT/GET are minted by the API, so the client uploads straight to R2
# and the API never proxies photos.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kitchen-photos
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# R2 requires path-style addressing with a custom endpoint.
S3_FORCE_PATH_STYLE=true

# ---- Auth (JWT) ----
# REQUIRED. At least 32 chars in production, and not the example placeholder.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- OAuth (Apple / Google) ----
# REQUIRED in production: the aud claim of incoming ID tokens is pinned to these,
# so a token minted for any other app is rejected. Comma-separated — one client
# id per platform. Google client ids are free (Google Cloud console); Apple
# requires the paid Apple Developer Program.
GOOGLE_CLIENT_ID=<ios>.apps.googleusercontent.com,<web>.apps.googleusercontent.com
APPLE_CLIENT_ID=com.kitchenai.app

# Apple Sign-In token revocation at account deletion. Leave the mock on until
# you have Apple credentials; set to false and fill the four values to revoke
# for real (required for App Store Guideline 5.1.1(v)).
APPLE_REVOKE_MOCK=true
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENC_KEY=

# ---- AI (metered — the only usage-priced dependency) ----
# Keep AI_MOCK=true to run the whole system offline and free while you validate
# the deployment. Flip to false and add a key to serve real model output; the
# daily budget caps spend. Consider an OpenRouter-compatible key here if you
# prefer (the provider port is OpenAI-API-compatible).
AI_MOCK=true
OPENAI_API_KEY=
OPENAI_MODEL_PLANNING=gpt-5
OPENAI_MODEL_VISION=gpt-5
OPENAI_MODEL_CHEAP=gpt-5-mini
AI_VISION_VENDOR=openai
GEMINI_API_KEY=
GEMINI_MODEL_VISION=gemini-3-flash
AI_DAILY_BUDGET_USD=2.00

# ---- External APIs (optional) ----
YOUTUBE_API_KEY=
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org

# ---- Payments (RevenueCat) ----
# Keep the mock on until store products + RevenueCat exist. Set to false only
# with both values below populated (the webhook secret is the only barrier to
# free credits).
PAYMENTS_MOCK=true
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
