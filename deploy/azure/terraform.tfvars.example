# Copy this file to terraform.tfvars and fill it in. terraform.tfvars is
# gitignored because it holds your subscription-specific values.

# From `az account show --query id -o tsv`
subscription_id = "00000000-0000-0000-0000-000000000000"

# Azure region for everything.
location = "eastus"

# The SSH public key generated for this VM.
ssh_public_key_path = "~/.ssh/kitchen-ai-oracle.pub"

# --- Optional overrides ---
# resource_group_name = "kitchen-ai"
# vm_size             = "Standard_B2s"     # B1s = free-tier-eligible but 1 GB RAM
# ssh_ingress_cidr    = "0.0.0.0/0"        # tighten to <your-ip>/32
# ubuntu_sku          = "22_04-lts-gen2"
